<Window x:Class="Schedule1ModdingTool.Views.GlbSceneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="3D Scene Editor" Width="1280" Height="820" MinWidth="950" MinHeight="600"
        Background="{StaticResource DarkBackgroundBrush}" Foreground="{StaticResource LightTextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <wv:WebView2 x:Name="Editor" />
        <TextBlock x:Name="ErrorMessage" Visibility="Collapsed" TextWrapping="Wrap" Margin="30" />
    </Grid>
</Window>
