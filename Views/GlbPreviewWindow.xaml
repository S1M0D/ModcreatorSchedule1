<Window x:Class="Schedule1ModdingTool.Views.GlbPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GLB model preview" Width="1040" Height="720" MinWidth="760" MinHeight="500"
        Background="{StaticResource DarkBackgroundBrush}" Foreground="{StaticResource LightTextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="ModelName" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
        <wv:WebView2 x:Name="Viewer" Grid.Row="1" />
        <TextBlock x:Name="ErrorMessage" Grid.Row="1" TextWrapping="Wrap" Margin="20" Visibility="Collapsed" />
        <StackPanel x:Name="PlacementPanel" Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Placement in game · offsets in metres, rotation in degrees" Margin="0,0,0,8" />
            <UniformGrid Columns="7">
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Scale"/><TextBox Text="{Binding ModelScale, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextBoxStyle}"/></StackPanel>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Rotation X"/><TextBox Text="{Binding ModelRotationX, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextBoxStyle}"/></StackPanel>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Rotation Y"/><TextBox Text="{Binding ModelRotationY, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextBoxStyle}"/></StackPanel>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Rotation Z"/><TextBox Text="{Binding ModelRotationZ, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextBoxStyle}"/></StackPanel>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Offset X"/><TextBox Text="{Binding ModelOffsetX, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextBoxStyle}"/></StackPanel>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Offset Y"/><TextBox Text="{Binding ModelOffsetY, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextBoxStyle}"/></StackPanel>
                <StackPanel><TextBlock Text="Offset Z"/><TextBox Text="{Binding ModelOffsetZ, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextBoxStyle}"/></StackPanel>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
