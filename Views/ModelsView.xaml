<UserControl x:Class="Schedule1ModdingTool.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Schedule1ModdingTool.Views">
    <Grid Background="{StaticResource DarkBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <views:WorkspaceHeader Grid.Row="0" DataContext="{Binding WorkspaceViewModel}" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" MaxWidth="850" HorizontalAlignment="Left">
                <TextBlock Text="3D Models" Style="{StaticResource PanelHeaderStyle}" FontSize="20" />
                <TextBlock Margin="0,8,0,12" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap"
                           Text="Import GLBs or Unity AssetBundles. Use Preview GLB for a quick look, or open the Scene Editor to arrange several library GLBs and basic shapes into one model. Export the scene as a new GLB, then select it on a Custom Product or Furniture item." />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Import model" Command="{Binding AddModelCommand}" Style="{StaticResource IconButtonStyle}"
                            Background="{StaticResource AccentOrangeBrush}" Foreground="White" Padding="12,7" HorizontalAlignment="Left" Margin="0,0,8,0" />
                    <Button Content="Open scene editor" Click="OpenSceneEditor_Click" Style="{StaticResource IconButtonStyle}" Padding="12,7" HorizontalAlignment="Left" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding CurrentProject.Models}" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource LightTextBrush}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding RelativePath}" Foreground="{StaticResource DimTextBrush}" Margin="0,3,0,10" />
                                    <TextBlock Text="{Binding FormatLabel}" Foreground="{StaticResource DimTextBrush}" Margin="0,0,0,8" />
                                    <StackPanel>
                                        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsGlb}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <Label Content="Prefab asset name inside bundle" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding PrefabName, UpdateSourceTrigger=PropertyChanged}" LostFocus="PrefabName_LostFocus" Style="{StaticResource TextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsGlb}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <Button Content="Preview GLB" Click="PreviewModel_Click" HorizontalAlignment="Left" Padding="12,7" Margin="0,0,8,0" Style="{StaticResource IconButtonStyle}" />
                                    <Button Content="Add to scene" Click="AddToScene_Click" HorizontalAlignment="Left" Padding="12,7" Margin="0,0,8,0" Style="{StaticResource IconButtonStyle}" />
                                    </StackPanel>
                                    <Button Content="Remove" Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding DataContext.RemoveModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
